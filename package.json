{
  "name": "@sing3demons/kp",
  "version": "0.1.0",
  "description": "A tiny, type-safe, Hono-like web framework for Bun and Node",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/adapter/node.d.ts",
      "import": "./dist/adapter/node.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "example:bun": "bun examples/bun.ts",
    "example:node": "node examples/node.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.0"
  }
}
