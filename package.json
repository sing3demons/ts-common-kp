{
  "name": "@sing3demons/kp",
  "version": "1.1.3",
  "description": "A tiny, type-safe, Hono-like web framework for Bun and Node",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sing3demons/ts-common-kp.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kp": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./node": {
      "types": "./dist/adapter/node.d.ts",
      "import": "./dist/adapter/node.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples && tsc --noEmit -p test/no-logger",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "example:bun": "bun examples/bun-app/src/main.ts",
    "example:node": "tsx examples/node-app/src/main.ts",
    "test:node-app": "cd examples/node-app && tsx --test test/*.node-test.ts",
    "prepublishOnly": "bun test && bun run typecheck && bun run build",
    "cli": "bun src/cli/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.1.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
